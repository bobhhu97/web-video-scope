{
  "name": "web-video-scope",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --mode background && node scripts/assert-fresh-build.mjs",
    "package": "node scripts/package-release.mjs",
    "dev": "vite build --watch",
    "harness": "vite build --mode harness",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm harness && node scripts/verify-harness.mjs",
    "verify:headed": "node scripts/verify-harness.mjs --headed",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:all": "pnpm build && pnpm test && node scripts/verify-manifest.mjs && node scripts/verify-e2e.mjs && node scripts/verify-layout.mjs && node scripts/verify-cie-ui.mjs && node scripts/verify-scatter.mjs && node scripts/verify-cie-fill.mjs && node scripts/verify-ire.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bench:upload": "node scripts/bench-upload.mjs",
    "capture:readme": "node scripts/capture-readme.mjs",
    "verify:ui": "node scripts/verify-layout.mjs",
    "verify:scatter": "node scripts/verify-scatter.mjs && node scripts/verify-cie-fill.mjs",
    "verify:cie": "node scripts/verify-cie-ui.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@webgpu/types": "^0.1.60",
    "jsdom": "^31.0.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
